<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- 顶部栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="DCL工具"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 工具区域标题 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="常用工具"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                android:paddingStart="8dp"
                android:paddingBottom="8dp"/>

            <!-- 第一行工具 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_chat"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="💬"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="聊天室"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_crypto"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="🔐"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="加解密"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

            </LinearLayout>

            <!-- 第二行工具 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/card_shell"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="💻"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shell执行器"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_security"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="🛡️"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="安全防护"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

            </LinearLayout>

            <!-- 第三行工具 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/card_benchmark"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="📊"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="性能跑分"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_file_analyzer"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="📁"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="文件分析器"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

            </LinearLayout>

            <!-- 第四行工具 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/card_github"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="🐙"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GitHub"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_sponsor"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="❤️"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="赞助支持"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

            </LinearLayout>

            <!-- 第五行工具 - Agent -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/card_agent"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="🤖"
                        android:textSize="24sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Agent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>

                </LinearLayout>

            </LinearLayout>

            <!-- 底部信息 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DCL安全工具箱 v1.0.0"
                android:textSize="11sp"
                android:textColor="#BDBDBD"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:paddingBottom="8dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
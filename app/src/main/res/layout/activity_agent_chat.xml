<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

         <androidx.appcompat.widget.Toolbar
             android:id="@+id/toolbar"
             android:layout_width="match_parent"
             android:layout_height="?attr/actionBarSize"
             android:title="Agent"
             app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
             
             <LinearLayout
                 android:layout_width="wrap_content"
                 android:layout_height="match_parent"
                 android:orientation="horizontal"
                 android:layout_gravity="end"
                 android:gravity="center_vertical">
                 
                 <ImageView
                     android:id="@+id/btn_config"
                     android:layout_width="40dp"
                     android:layout_height="40dp"
                     android:padding="8dp"
                     android:src="@drawable/ic_agent_settings"
                     android:contentDescription="配置"/>
                 
                 <ImageView
                     android:id="@+id/btn_persona"
                     android:layout_width="40dp"
                     android:layout_height="40dp"
                     android:padding="8dp"
                     android:src="@drawable/ic_puzzle"
                     android:contentDescription="角色扮演"/>
                 
             </LinearLayout>
         </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/ll_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"/>

    </ScrollView>

    <ProgressBar
        android:id="@+id/pb_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- 思考控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/iv_thinking_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_thinking_on"
            android:contentDescription="思考状态"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="深度思考"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginStart="8dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_thinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"/>

    </LinearLayout>

    <!-- 思考程度滑块（仅思考开启时显示） -->
    <LinearLayout
        android:id="@+id/layout_thinking_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:background="#F8F8F8"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="思考程度"
            android:textSize="12sp"
            android:textColor="#888888"/>

        <SeekBar
            android:id="@+id/seekbar_thinking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="2"
            android:progress="1"/>

        <TextView
            android:id="@+id/tv_thinking_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="中"
            android:textSize="12sp"
            android:textColor="#888888"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="输入消息…"
            android:maxLines="4"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>